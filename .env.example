# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Circle API Keys
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_WEBHOOK_PUBLIC_KEY=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
KIT_KEY=
PRIVATE_KEY=

# Platform Admin Emails (DevSecOps Option 1)
ADMIN_EMAIL="admin@admin.com"
VITE_ADMIN_EMAIL="admin@admin.com"

# Arc Testnet Configuration (for frontend connection)
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
VITE_ARC_CHAIN_ID=5042002
VITE_ARC_CURRENCY_SYMBOL=USDC
VITE_ARC_EXPLORER_URL=https://testnet.arcscan.app

# Supabase Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Arc Native Deposit System (Phase 4)
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_MASTER_MNEMONIC=
ARC_HOT_WALLET_ADDRESS=
ARC_USDC_CONTRACT=0x3600000000000000000000000000000000000000

# Platform Treasury Address (DevSecOps Option)
PLATFORM_TREASURY_ADDRESS=
LOUNGE_NFT_ADDRESS=0x4aaa0f998817be80405ab1ef4106f3ac9d462b5e

# Admin Secret for secure internal routes
ADMIN_SECRET=
